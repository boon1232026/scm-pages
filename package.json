{
  "name": "social-commerce-manager",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": { "node": ">=22 <23" },
  "scripts": {
    "dev": "pnpm -r --parallel --filter './apps/*' run dev",
    "build": "pnpm -r run build",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "infra:up": "docker compose -f infrastructure/docker/docker-compose.yml up -d",
    "infra:down": "docker compose -f infrastructure/docker/docker-compose.yml down",
    "db:migrate": "pnpm --filter @scm/api exec prisma migrate dev",
    "db:deploy": "pnpm --filter @scm/api exec prisma migrate deploy",
    "db:studio": "pnpm --filter @scm/api exec prisma studio"
  },
  "devDependencies": {
    "typescript": "~5.7.3",
    "prettier": "^3.4.2"
  }
}
